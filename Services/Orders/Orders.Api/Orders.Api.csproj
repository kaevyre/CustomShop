<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.9.*" />
    <!-- Лаб. 06: gRPC-сервер і Redis (IDistributedCache) -->
    <PackageReference Include="Grpc.AspNetCore" Version="2.76.0" />
    <!-- Лаб. 07: стандартний gRPC Health Checking Protocol (відповідає на основі health checks ASP.NET Core) -->
    <PackageReference Include="Grpc.AspNetCore.HealthChecks" Version="2.76.0" />
    <PackageReference Include="Aspire.StackExchange.Redis.DistributedCaching" Version="9.5.2" />
    <!-- Лаб. 08: Aspire-інтеграція RabbitMQ (IConnection, health check, телеметрія) -->
    <PackageReference Include="Aspire.RabbitMQ.Client.v7" Version="9.5.2" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Protos\orders.proto" GrpcServices="Server" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Orders.Bll\Orders.Bll.csproj" />
    <ProjectReference Include="..\Orders.Dal\Orders.Dal.csproj" />
    <!-- Лаб. 08: подієва шина (consumer, топологія, контракти подій) -->
    <ProjectReference Include="..\..\..\Platform.EventBus\Platform.EventBus.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Лаб. 05: спільні налаштування платформи (Serilog, OpenTelemetry, CorrelationId, health checks) -->
    <ProjectReference Include="..\..\..\Platform.ServiceDefaults\Platform.ServiceDefaults.csproj" />
  </ItemGroup>

</Project>

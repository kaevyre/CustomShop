{
  "MongoDb": {
    "ConnectionString": "mongodb://localhost:27017/?maxPoolSize=50&minPoolSize=5&serverSelectionTimeoutMS=5000&connectTimeoutMS=5000",
    "DatabaseName": "customshop_reviews",
    "Seed": true
  },
  "Performance": {
    "SlowRequestMs": 500
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "Fatal"
      }
    }
  },
  "Kestrel": {
    "Endpoints": {
      "http": { "Url": "http://localhost:5082", "Protocols": "Http1" },
      "grpc": { "Url": "http://localhost:5182", "Protocols": "Http2" }
    }
  },
  "AllowedHosts": "*"
}
